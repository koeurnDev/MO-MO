# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# PostgreSQL Connection String (e.g., from Neon.tech)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# The HTTPS URL of your frontend (Vite app on Render or ngrok)
WEBAPP_URL=https://your-mini-app-webapp.onrender.com

# Admin User ID (Get from @userinfobot)
SUPERADMIN_ID=12345678

# Session secret for JWT signing. Use a secure random string (min 32 chars).
SESSION_SECRET=your_session_secret_here

# Cloudinary Credentials (for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Webhook URL for production (if not using long polling)
WEBHOOK_URL=https://your-mini-app-bot.onrender.com/webhook

# Port for the Express server
PORT=3000

# --- Performance / Cache (recommended for production) ---
# Render Redis (auto-linked via render.yaml REDIS_URL)
# REDIS_URL=redis://...

# Upstash Redis REST (optional — extra cache tier, Render/Vercel friendly)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# Keep-alive: auto-set on Render as RENDER_EXTERNAL_URL
# Override if needed:
# KEEP_ALIVE_URL=https://your-mini-app-bot.onrender.com

# Disable workers (optional)
# DISABLE_KEEP_ALIVE=true
# DISABLE_IMAGE_SCAN=true

# Unpaid order Telegram reminders (off by default — admin confirms payments manually)
# ENABLE_PAYMENT_REMINDERS=true

# Run migrations automatically on Render via preDeployCommand (render.yaml).
# Locally: cd bot && npm run migrate
